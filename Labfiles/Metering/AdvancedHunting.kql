// Software metering with Microsoft Defender XDR advanced hunting (trainer demo)
// Needs Microsoft Defender for Endpoint: DeviceProcessEvents is populated only by MDE.
// Counts process starts - there is no process end, so this shows launches, not minutes of use.
// Source: https://learn.microsoft.com/defender-xdr/advanced-hunting-deviceprocessevents-table
// VERIFY: data retention in advanced hunting (assumed 30 days) and MDE plan in the course tenant.

// 1. Launches per watched app: how many starts, devices and users, last start
let Watchlist = dynamic(["visio.exe", "winproj.exe", "msaccess.exe", "notepad++.exe"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName in~ (Watchlist)
| summarize Launches = count(), Devices = dcount(DeviceId), Users = dcount(AccountUpn),
            LastLaunch = max(Timestamp) by App = tolower(FileName), Product = ProcessVersionInfoProductName
| order by Launches desc

// 2. Per device and user: who used a watched app, and when last
let Watchlist = dynamic(["visio.exe", "winproj.exe", "msaccess.exe", "notepad++.exe"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName in~ (Watchlist)
| summarize Launches = count(), LastLaunch = max(Timestamp) by DeviceName, AccountUpn, App = tolower(FileName)
| order by App asc, LastLaunch desc

// 3. Top 25 launched apps by distinct users (signed apps only, no system processes)
DeviceProcessEvents
| where Timestamp > ago(7d)
| where isnotempty(ProcessVersionInfoProductName) and AccountDomain !in~ ("nt authority", "font driver host", "window manager")
| summarize Users = dcount(AccountUpn), Devices = dcount(DeviceId), Launches = count()
            by App = tolower(FileName), Product = ProcessVersionInfoProductName, Company = ProcessVersionInfoCompanyName
| top 25 by Users desc
