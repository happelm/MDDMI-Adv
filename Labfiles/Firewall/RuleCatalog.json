  "groups": [
    {
      "id": "ping",
      "name": "Ping (ICMP echo)",
      "description": "ICMPv4 and ICMPv6 echo request for troubleshooting. Built-in group: Core Networking Diagnostics. Needs Windows 11 (IcmpTypesAndCodes).",
      "rules": [
        "icmp4",
        "icmp6"
      ]
    },
    {
      "id": "smb",
      "name": "File sharing (SMB)",
      "description": "TCP 445 for admin shares (C$, ADMIN$) and named pipes. Built-in group: File and Printer Sharing (SMB-In only).",
      "rules": [
        "smb"
      ]
    },
    {
      "id": "rdp",
      "name": "Remote Desktop",
      "description": "TCP and UDP 3389. Built-in group: Remote Desktop (User Mode).",
      "rules": [
        "rdptcp",
        "rdpudp"
      ]
    },
    {
      "id": "winrm",
      "name": "PowerShell remoting (WinRM HTTP)",
      "description": "TCP 5985. Built-in group: Windows Remote Management.",
      "rules": [
        "winrm"
      ]
    },
    {
      "id": "wmi",
      "name": "WMI",
      "description": "RPC endpoint mapper, WMI service and asynchronous callbacks. Built-in group: Windows Management Instrumentation (WMI).",
      "rules": [
        "epmap",
        "wmi",
        "wmiasync"
      ]
    },
    {
      "id": "eventlog",
      "name": "Remote Event Log Management",
      "description": "Remote Event Viewer over RPC and named pipes. Built-in group: Remote Event Log Management.",
      "rules": [
        "epmap",
        "eventlog",
        "smb"
      ]
    },
    {
      "id": "svcmgmt",
      "name": "Remote Service Management",
      "description": "Remote services.msc and sc.exe. Built-in group: Remote Service Management.",
      "warning": "Remote service creation is a common lateral movement technique (PsExec style). Scope it to admin hosts.",
      "rules": [
        "epmap",
        "svcmgmt",
        "smb"
      ]
    },
    {
      "id": "tasks",
      "name": "Remote Scheduled Tasks Management",
      "description": "Remote Task Scheduler. Built-in group: Remote Scheduled Tasks Management.",
      "warning": "Remote task creation is a common lateral movement technique. Scope it to admin hosts.",
      "rules": [
        "epmap",
        "tasks"
      ]
    },
    {
      "id": "fwmgmt",
      "name": "Windows Defender Firewall Remote Management",
      "description": "Remote wf.msc and NetSecurity cmdlets. Built-in group: Windows Defender Firewall Remote Management.",
      "rules": [
        "epmap",
        "fwmgmt"
      ]
    }
  ],
  "rules": {
    "icmp4": {
      "name": "Core Networking Diagnostics - ICMP Echo Request (ICMPv4-In)",
      "description": "Ping (ICMPv4 echo request) for troubleshooting. Built-in group: Core Networking Diagnostics.",
      "direction": "in",
      "action": "allow",
      "profiles": [
        1
      ],
      "protocol": 1,
      "icmpTypesAndCodes": [
        "8:*"
      ],
      "remoteAddressRanges": [
        "%MANAGEMENT%"
      ],
      "appFilePath": "System"
    },
    "icmp6": {
      "name": "Core Networking Diagnostics - ICMP Echo Request (ICMPv6-In)",
      "description": "Ping (ICMPv6 echo request) for troubleshooting. Built-in group: Core Networking Diagnostics.",
      "direction": "in",
      "action": "allow",
      "profiles": [
        1
      ],
      "protocol": 58,
      "icmpTypesAndCodes": [
        "128:*"
      ],
      "remoteAddressRanges": [
        "%MANAGEMENT%"
      ],
      "appFilePath": "System"
    },
    "smb": {
      "name": "File and Printer Sharing (SMB-In)",
      "description": "SMB (TCP 445) for admin shares (C$, ADMIN$) and remote tools. Built-in group: File and Printer Sharing. Also covers the NP-In (named pipes) rules of Remote Event Log Management and Remote Service Management.",
      "direction": "in",
      "action": "allow",
      "profiles": [
        1
      ],
      "protocol": 6,
      "localPortRanges": [
        "445"
      ],
      "appFilePath": "System",
      "remoteAddressRanges": [
        "%MANAGEMENT%"
      ]
    },
    "rdptcp": {
      "name": "Remote Desktop - User Mode (TCP-In)",
      "description": "RDP (TCP 3389). Built-in group: Remote Desktop.",
      "direction": "in",
      "action": "allow",
      "profiles": [
        1
      ],
      "protocol": 6,
      "localPortRanges": [
        "3389"
      ],
      "appFilePath": "%SystemRoot%\\system32\\svchost.exe",
      "appServiceName": "TermService",
      "remoteAddressRanges": [
        "%MANAGEMENT%"
      ]
    },
    "rdpudp": {
      "name": "Remote Desktop - User Mode (UDP-In)",
      "description": "RDP UDP transport (UDP 3389). Built-in group: Remote Desktop.",
      "direction": "in",
      "action": "allow",
      "profiles": [
        1
      ],
